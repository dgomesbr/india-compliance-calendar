---
import '../styles/global.css';
import '../styles/app.css';
import '../styles/pages.css';
import Icon from '../components/Icon.astro';
import ProfileButton from '../components/ProfileButton.tsx';

export type NavKey = 'overview' | 'calendar' | 'planner' | 'report' | 'updates' | 'sources' | 'subscribe' | 'none';

interface Props {
  title: string;
  description?: string;
  active: NavKey;
  /** Preload the data bundle for pages whose islands need it. */
  preloadData?: boolean;
}

const { title, description = 'Indian statutory due dates with sources, penalty exposure, holidays and regulator updates.', active, preloadData = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const repo = 'https://github.com/dgomesbr/india-compliance-calendar';
const pageTitle = active === 'overview' ? 'India Compliance Calendar' : `${title} - India Compliance Calendar`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://dgomesbr.github.io').toString();

const nav: { key: NavKey; label: string; href: string }[] = [
  { key: 'overview', label: 'Overview', href: base },
  { key: 'calendar', label: 'Calendar', href: `${base}calendar/` },
  { key: 'planner', label: 'Planner', href: `${base}planner/` },
  { key: 'report', label: 'Report', href: `${base}report/` },
  { key: 'updates', label: 'Updates', href: `${base}updates/` },
  { key: 'sources', label: 'Sources', href: `${base}sources/` },
  { key: 'subscribe', label: 'Subscribe', href: `${base}subscribe/` },
];
const built = new Date().toISOString().slice(0, 10);
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0e2a47" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Regulator updates" href={`${base}updates.xml`} />
    <link rel="alternate" type="text/calendar" title="All obligations (ICS)" href={`${base}ics/all.ics`} />
    {preloadData && <link rel="preload" href={`${base}api/v1/bundle.json`} as="fetch" crossorigin="anonymous" />}
    <meta name="icc-base" content={base} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="masthead no-print">
      <div class="page masthead-row">
        <a class="wordmark" href={base} aria-label="India Compliance Calendar, overview">
          <Icon name="mark" class="wordmark-mark" />
          <span class="wordmark-text">India Compliance Calendar</span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          <ul>
            {
              nav.map((item) => (
                <li>
                  <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="masthead-tools">
          <ProfileButton client:idle />
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="footer no-print">
      <div class="page footer-row">
        <p class="footer-note">
          Information only, not legal advice. Every date links to the official source it was taken from; confirm on
          the portal before you file.
        </p>
        <ul class="footer-links">
          <li><a href={`${base}sources/`}>Method and sources</a></li>
          <li><a href={`${base}subscribe/`}>Feeds, API and MCP</a></li>
          <li><a href={`${repo}/issues/new?labels=correction&title=Correction:%20`}>Report a correction</a></li>
          <li><a href={repo}>Source code</a></li>
        </ul>
        <p class="faint footer-built">Built {built}</p>
      </div>
    </footer>
  </body>
</html>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--navy);
    color: var(--navy-ink);
    box-shadow: 0 1px 0 rgba(16, 24, 40, 0.18);
  }
  .masthead-row {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    min-height: 64px;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--navy-ink);
    text-decoration: none;
    flex: none;
  }
  .wordmark:hover {
    color: var(--navy-ink);
  }
  .wordmark :global(.wordmark-mark) {
    width: 24px;
    height: 24px;
    stroke: currentColor;
    stroke-width: 1.75;
  }
  .wordmark-text {
    font-size: var(--t-md);
    font-weight: 650;
    letter-spacing: -0.01em;
  }
  .primary-nav {
    flex: 1;
    min-width: 0;
  }
  .primary-nav ul {
    display: flex;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .primary-nav ul::-webkit-scrollbar {
    display: none;
  }
  .primary-nav a {
    position: relative;
    display: block;
    padding: 22px var(--s-3) 21px;
    color: var(--navy-ink-2);
    font-size: var(--t-sm);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    transition: color 150ms var(--ease-out);
  }
  .primary-nav a:hover {
    color: var(--navy-ink);
  }
  .primary-nav a[aria-current='page'] {
    color: var(--navy-ink);
  }
  .primary-nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: var(--s-3);
    right: var(--s-3);
    bottom: 0;
    height: 3px;
    border-radius: 3px 3px 0 0;
    background: #8fb0ff;
  }
  .primary-nav a:focus-visible {
    outline-color: #fff;
    outline-offset: -4px;
  }
  .masthead-tools {
    flex: none;
  }
  main {
    min-height: calc(100vh - 220px);
    outline: none;
  }
  .footer {
    margin-top: var(--s-8);
    border-top: 1px solid var(--rule);
    background: var(--layer-1);
  }
  .footer-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--s-4) var(--s-6);
    padding-top: var(--s-6);
    padding-bottom: var(--s-6);
  }
  .footer-note {
    max-width: 62ch;
    color: var(--ink-2);
    font-size: var(--t-sm);
  }
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-sm);
    font-weight: 600;
  }
  .footer-links a {
    color: var(--ink-2);
    text-decoration: none;
  }
  .footer-links a:hover {
    color: var(--accent);
  }
  .footer-built {
    grid-column: 1 / -1;
    font-size: var(--t-xs);
  }
  @media (max-width: 900px) {
    .masthead-row {
      flex-wrap: wrap;
      gap: 0 var(--s-4);
      padding-top: var(--s-2);
    }
    .wordmark {
      flex: 1;
      min-height: 44px;
    }
    .primary-nav {
      order: 3;
      flex-basis: 100%;
      margin: 0 calc(var(--gutter) * -1);
      padding: 0 calc(var(--gutter) - var(--s-3));
    }
    .primary-nav a {
      padding: 12px var(--s-3) 13px;
    }
    .footer-row {
      grid-template-columns: 1fr;
    }
  }
</style>
