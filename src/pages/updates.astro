---
import Shell from '../layouts/Shell.astro';
import PageBand from '../components/PageBand.astro';
import { formatDate } from '../lib/dates.ts';
import { addMonths } from '../lib/dates.ts';
import { buildDate, getBundle, getFeeds, getHolidayUpdates, getUpdates, occurrencesBetween } from '../lib/site-data.ts';

const updates = getUpdates();
const feeds = getFeeds();
const { rules } = getBundle();
const byId = new Map(rules.map((r) => [r.id, r]));
const today = buildDate();
const changes = occurrencesBetween(addMonths(today, -6), addMonths(today, 18))
  .filter((o) => o.extended)
  .map((o) => ({ o, r: byId.get(o.ruleId)! }));
const sources = [...new Map(updates.items.map((u) => [u.source, u.sourceName])).entries()];
const holidayRuns = getHolidayUpdates();
const lastRun = holidayRuns[0];
const titleOf = new Map(getBundle().holidays.map((l) => [l.id, l.title]));
const withChanges = holidayRuns.filter((r) => r.changes.length).slice(0, 4);
const nextFirst = (() => {
  const [y, m] = today.split('-').map(Number);
  return formatDate(`${m === 12 ? y + 1 : y}-${String(m === 12 ? 1 : m + 1).padStart(2, '0')}-01`, { weekday: false });
})();
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Shell title="Regulator updates" active="updates" description="Latest circulars, notifications and press releases collected daily from Indian regulators.">
  <PageBand
    title="Regulator updates"
    lede={`Circulars, notifications and press releases collected each day from the regulators' own feeds, plus every due-date extension the calendar has applied.${updates.fetched ? ` Last collected ${formatDate(updates.fetched.slice(0, 10))}.` : ' The first collection runs on the next scheduled build.'}`}
  >
    <p slot="after-title" class="band-links">
      <a href={`${base}updates.xml`}>RSS feed of these updates</a>
    </p>
  </PageBand>
  <div class="page read">

    <section class="read-section" aria-labelledby="holiday-changes">
      <h2 id="holiday-changes">Holiday changes</h2>
      <div class="prose">
        <p>
          Indian holidays move during the year: festivals follow the moon, and the Centre, the states and RBI declare or shift
          days as they go. On the first of every month the lists are refreshed from their official sources (RBI's holiday
          matrix for bank holidays by state, the National Portal of India's copy of the DoPT list, NSE's holiday API, and the
          authorities' own feeds for Canada and the United States), and what changed is listed here. A date someone corrected
          by hand from a later order is never moved back by a source that has not caught up; it is flagged instead.
        </p>
        {
          lastRun ? (
            <p>
              Last update {formatDate(lastRun.date, { weekday: false })}: {lastRun.confirmed.length} lists confirmed unchanged,{' '}
              {lastRun.changes.length} changed.
              {lastRun.skipped.length > 0 && ` Not reachable this time: ${lastRun.skipped.map((s) => `${s.source} (${s.reason})`).join('; ')}.`}
              {' '}Next update {nextFirst}.
            </p>
          ) : (
            <p class="muted">The first monthly update runs on {nextFirst}.</p>
          )
        }
      </div>
      {
        withChanges.length > 0 && (
          <ul class="feed-list">
            {withChanges.flatMap((run) =>
              run.changes.map((c) => (
                <li class="feed-item">
                  <span class="num faint">{formatDate(run.date, { weekday: false })}</span>
                  <span>
                    <strong>{titleOf.get(c.list) ?? c.list}</strong>:{' '}
                    {[
                      c.created ? `published, ${c.added.length} dates` : '',
                      !c.created && c.added.length ? `added ${c.added.map((h) => `${formatDate(h.date, { weekday: false })} (${h.name})`).join(', ')}` : '',
                      c.removed.length ? `removed ${c.removed.map((h) => `${formatDate(h.date, { weekday: false })} (${h.name})`).join(', ')}` : '',
                      c.moved.length ? `moved ${c.moved.map((m) => `${m.name} from ${formatDate(m.from, { weekday: false })} to ${formatDate(m.to, { weekday: false })}`).join(', ')}` : '',
                      c.conflicts.length ? `to review: ${c.conflicts.map((x) => `${formatDate(x.date, { weekday: false })} ${x.name}`).join(', ')}` : '',
                    ]
                      .filter(Boolean)
                      .join('; ') || 'confirmed as published'}
                    .
                    <span class="feed-meta">{c.source}</span>
                  </span>
                </li>
              )),
            )}
          </ul>
        )
      }
    </section>

    <section class="read-section" aria-labelledby="changes">
      <h2 id="changes">Extensions applied to the calendar</h2>
      {
        changes.length ? (
          <ul class="feed-list">
            {changes.map(({ o, r }) => (
              <li class="feed-item">
                <span class="num faint">{formatDate(o.due, { weekday: false })}</span>
                <span>
                  <a href={`${base}o/${r.id}/`}><span class="fig">{r.code}</span> {o.periodLabel}</a>: moved from {formatDate(o.originalDue ?? o.due, { weekday: false })}. {o.extended?.reason}
                  {o.extended?.source && <span class="feed-meta"><a href={o.extended.source.url} rel="noopener">{o.extended.source.title}</a></span>}
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">No extension is in force for the coming months.</p>
        )
      }
    </section>

    <section class="read-section" aria-labelledby="feed">
      <h2 id="feed">From the regulators</h2>
      {
        sources.length > 1 && (
          <div class="chips" role="group" aria-label="Filter by source" data-feed-filter>
            <button type="button" class="chip" aria-pressed="true" data-source="">All</button>
            {sources.map(([id, name]) => (
              <button type="button" class="chip" aria-pressed="false" data-source={id}>{name}</button>
            ))}
          </div>
        )
      }
      {
        updates.items.length ? (
          <ul class="feed-list" data-feed-list>
            {updates.items.map((u) => (
              <li class="feed-item" data-source={u.source}>
                <span class="num faint">{formatDate(u.date, { weekday: false })}</span>
                <span>
                  <a href={u.url} rel="noopener">{u.title}</a>
                  <span class="feed-meta label faint">{u.sourceName}</span>
                </span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="muted">Nothing collected yet. The daily GitHub Actions job fills this list from the sources below.</p>
        )
      }
    </section>

    <section class="read-section" aria-labelledby="feed-sources">
      <h2 id="feed-sources">Feeds we collect</h2>
      <table class="data-table">
        <thead><tr><th class="label">Source</th><th class="label">Feed</th><th class="label">Last run</th></tr></thead>
        <tbody>
          {
            feeds.map((f) => {
              const s = updates.sources.find((x) => x.id === f.id);
              return (
                <tr>
                  <td>{f.name}</td>
                  <td><a href={f.url} rel="noopener">{f.url.replace(/^https?:\/\//, '')}</a></td>
                  <td class="muted">{s ? (s.ok ? `${s.count} items` : `Failed: ${s.error ?? 'unreachable'}`) : 'Not yet collected'}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </section>
  </div>
</Shell>

<script>
  const group = document.querySelector('[data-feed-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-feed-list] > li');
  group?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    const source = btn.dataset.source ?? '';
    group.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
    items.forEach((li) => (li.hidden = Boolean(source) && li.dataset.source !== source));
  });
</script>
