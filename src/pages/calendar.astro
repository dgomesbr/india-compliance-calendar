---
import Shell from '../layouts/Shell.astro';
import MonthCalendar from '../components/MonthCalendar.tsx';
import { MONTHS_LONG, parts } from '../lib/dates.ts';
import { buildDate } from '../lib/site-data.ts';

const now = parts(buildDate());
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<Shell title="Calendar" active="calendar" preloadData description="Month view of Indian statutory due dates, with central holidays and the holiday calendars of Canada, Ontario and the US.">
  <MonthCalendar client:only="preact">
    <div slot="fallback" class="cal">
      <section class="band cal-band" aria-labelledby="cal-title">
        <div class="page band-inner">
          <div class="band-head">
            <h1 id="cal-title" class="band-title display">{MONTHS_LONG[now.m - 1]} <span class="num">{now.y}</span></h1>
            <p class="band-sub js-only">Loading</p>
          </div>
        </div>
      </section>
      <div class="page js-only" aria-busy="true"><div class="skeleton" style="height:520px;margin-top:32px"></div></div>
    </div>
  </MonthCalendar>
  <noscript>
    <p class="page noscript-note">
      The month view needs JavaScript. The same dates are published as <a href={`${base}subscribe/`}>calendar feeds</a> and a
      <a href={`${base}api/v1/occurrences.json`}>JSON file</a>.
    </p>
  </noscript>
</Shell>
