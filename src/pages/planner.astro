---
import Shell from '../layouts/Shell.astro';
import PageBand from '../components/PageBand.astro';
import Planner from '../components/Planner.tsx';
---

<Shell
  title="Event planner"
  active="planner"
  preloadData
  description="Deadlines that run from an event: AGM, allotment, director change, charge, foreign investment."
>
  <PageBand
    title="Event planner"
    lede="Some deadlines run from something that happened, not from the calendar. Pick the event and its date to get every filing that follows from it, then add them to the overview."
  />
  <Planner client:only="preact">
    <div slot="fallback" class="page js-only" aria-busy="true"><div class="skeleton" style="height:320px;margin-top:24px"></div></div>
  </Planner>
  <noscript>
    <p class="page noscript-note">The planner needs JavaScript to date each deadline from the event you pick.</p>
  </noscript>
</Shell>
